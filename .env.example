# ============================================================================
# Multimodal Traffic Incident Detection & Network Recovery Platform
# Environment Configuration (.env.example)
# Copy this file to `.env` to override default local settings.
# ============================================================================

# Server Host & Port
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Automatically launch default web browser once /api/health returns HTTP 200
AUTO_OPEN_BROWSER=true

# Database Persistence
# Leave blank to use the default backend/data/traffic_platform.db
DB_PATH=

# CORS Allowed Origins (comma-separated, or * for local development)
CORS_ORIGINS=*

# Optional External Live Telemetry Integrations
# When omitted, the platform automatically uses verified historical & synthetic
# loop detector, probe GPS, and CCTV frame sequences with explicit provenance.
RTSP_STREAM_URL=
TMC_API_TOKEN=
WEATHER_STATION_API_KEY=
